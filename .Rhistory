#'
#' @return A list containing:
#'         - work_identifier: The input work_b_string.
#'         - expected_publisher: The input expected_publisher.
#'         - work_found: Logical, TRUE if an entry matching work_b_string was found in df$id.
#'         - actual_publisher_found: The publisher found in df$host_organization for work_b (or NA).
#'         - publisher_match: Logical, TRUE if the actual publisher matches the expected publisher.
#'         - is_cited: Logical, TRUE if work_b_string was found in any df$referenced_works list.
#'         - citing_indices: Numeric vector of row indices in df that cite work_b_string.
#'
verify_citation_publisher <- function(work_b_string, expected_publisher, df) {
# --- 1. Check if work b is published by expected_publisher ---
# Find the row index for work b using its string identifier (assuming it's in 'id')
# Using '==' for exact match as it's assumed to be an identifier like an ID
work_b_indices <- which(df$id == work_b_string)
publisher_match <- FALSE # Default to FALSE
actual_publisher <- NA   # Store the actual publisher if found
work_found <- FALSE      # Flag to indicate if work b's entry was found
if (length(work_b_indices) > 0) {
work_found <- TRUE
# If multiple matches for work_b_string in 'id', this implies non-unique IDs.
# We'll check the publisher of the first match found. Consider adding a warning if length > 1.
if (length(work_b_indices) > 1) {
warning(paste("Multiple entries found for id:", work_b_string, "- checking publisher of the first one."))
}
work_b_index <- work_b_indices[1]
actual_publisher <- df$host_organization[work_b_index]
# Check if actual_publisher is not NA and contains the expected publisher (case-insensitive)
# Use grepl for partial, case-insensitive matching for the publisher name
if (!is.na(actual_publisher) && grepl(expected_publisher, actual_publisher, ignore.case = TRUE)) {
publisher_match <- TRUE
}
} else {
# Work b's main entry not found in the dataframe based on work_b_string in 'id' column
# Cannot verify publisher.
# message(paste("Work '", work_b_string, "' not found using df$id, cannot verify publisher.")) # Optional message
}
# --- 2. Check if work b is cited in df$referenced_works ---
# Use logic similar to the original search_references function.
# Check if work_b_string exists *exactly* in any list within the referenced_works column.
# Assumes referenced_works contains lists/vectors and work_b_string is the exact citation form.
citing_indices <- which(sapply(df$referenced_works, function(reference_list) {
# Important: Check if reference_list is not NULL/NA before using %in%
!is.null(reference_list) && work_b_string %in% reference_list
}))
is_cited <- length(citing_indices) > 0
# --- 3. Return combined results ---
results <- list(
work_identifier = work_b_string,
expected_publisher = expected_publisher,
work_found = work_found,
actual_publisher_found = actual_publisher,
publisher_match = publisher_match, # Result of check 1
is_cited = is_cited,               # Result of check 2
citing_indices = citing_indices    # Indices of rows citing the work
)
return(results)
}
example_df <- data.frame(
id = c("A_ID", "B_ID", "C_ID"),
host_organization = c("University of Arizona", "Awesome Publisher Inc.", "Another Press"),
stringsAsFactors = FALSE # Important for list columns
)
# Add the list column separately
example_df$referenced_works <- list(
c("B_ID", "Other Ref 1"), # A cites B
character(0),             # B cites nothing
c("Some Ref")             # C cites something else
)
# Test 1: Work B exists, publisher matches, work B is cited by A.
cat("\n--- Test Case 1 ---\n")
result1 <- verify_citation_publisher(work_b_string = "B_ID",
expected_publisher = "Awesome Publisher", # Partial match should work
df = example_df)
print(result1)
# Test 2: Work B exists, publisher mismatch, work B is cited by A.
cat("\n--- Test Case 2 ---\n")
result2 <- verify_citation_publisher(work_b_string = "B_ID",
expected_publisher = "Wrong Publisher",
df = example_df)
print(result2)
# Test 3: Work B exists, publisher matches, work B is cited, but searching wrong citation string.
cat("\n--- Test Case 3 ---\n")
result3 <- verify_citation_publisher(work_b_string = "B_ID_Wrong_Format", # This string doesn't exist in referenced_works
expected_publisher = "Awesome Publisher",
df = example_df)
# We need to add 'B_ID_Wrong_Format' as an ID to check publisher, but it won't be found in refs
temp_df_3 <- rbind(example_df, data.frame(id="B_ID_Wrong_Format", host_organization="Awesome Publisher Inc.", referenced_works=I(list(character(0)))))
print(verify_citation_publisher("B_ID_Wrong_Format", "Awesome Publisher", temp_df_3))
# Test 4: Work B does not exist in the 'id' column (cannot check publisher), but is cited.
cat("\n--- Test Case 4 ---\n")
# Modify df so B_ID doesn't exist as an id, but is still cited by A
temp_df_4 <- example_df
temp_df_4$id[temp_df_4$id == "B_ID"] <- "Different_ID_B"
result4 <- verify_citation_publisher(work_b_string = "B_ID", # Searching for the citation string 'B_ID'
expected_publisher = "Awesome Publisher",
df = temp_df_4)
print(result4)
# Test 5: Work B exists, publisher matches, but is not cited by anyone.
cat("\n--- Test Case 5 ---\n")
temp_df_5 <- example_df
temp_df_5$referenced_works[[1]] <- c("Other Ref 1") # Remove B_ID from A's references
result5 <- verify_citation_publisher(work_b_string = "B_ID",
expected_publisher = "Awesome Publisher",
df = temp_df_5)
print(result5)
# The other criteria: choose one for output
