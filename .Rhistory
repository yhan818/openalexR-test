example_df <- data.frame(
id = c("A01", "B02", "C03", "D04", "E05"), # Add the 5th ID
title = c("Work A", "Work B", "Work C", "Work D", "Work E"), # Add the 5th title
stringsAsFactors = FALSE
)
# Now assign the 5-element list - this will work
example_df$referenced_works <- list(
c("CitedWorkX", "CitedWorkY"),    # Row 1 (A01)
c("CitedWorkZ"),                # Row 2 (B02)
c("CitedWorkX", "CitedWorkZ"),    # Row 3 (C03)
character(0),                   # Row 4 (D04)
NULL                            # Row 5 (E05)
)
print(example_df)
# Need to add id/title for the NULL row
