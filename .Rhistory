#'               within the reference lists in 'df$referenced_works'.
#' @param df The dataframe containing work information. Must include columns
#'           'id' and 'referenced_works'. 'referenced_works' is assumed
#'           to contain lists or vectors of citation strings.
#'
#' @return A vector containing the 'id' values from rows in 'df' where
#'         'work_b' was found in that row's 'referenced_works' list.
#'         Returns an empty vector of the appropriate type (e.g., character(0))
#'         if no citing works are found or if columns are missing.
#'
find_citing_works <- function(work_b, df) {
if (!is.data.frame(df)) {
stop("Error: 'df' must be a data frame.")
}
if (!"referenced_works" %in% names(df)) {
warning("Warning: Dataframe 'df' missing 'referenced_works' column. Returning empty vector.")
# Determine appropriate empty vector type based on 'id' column if it exists
if ("id" %in% names(df)) return(df$id[0]) else return(character(0))
}
if (!"id" %in% names(df)) {
warning("Warning: Dataframe 'df' missing 'id' column. Returning empty vector.")
return(character(0)) # Cannot return IDs if 'id' column is missing
}
if (!is.character(work_b) || length(work_b) != 1) {
stop("Error: 'work_b' must be a single string.")
}
# --- Find Indices ---
# Find indices where work_b exists exactly within the referenced_works list/vector.
# This handles cases where an element in referenced_works might be NULL.
indices_with_string <- which(sapply(df$referenced_works, function(reference_list) {
# Check if reference_list is not NULL before checking for work_b within it
!is.null(reference_list) && work_b %in% reference_list
}))
# --- Retrieve and Return IDs ---
# If no indices found, this correctly returns an empty vector df$id[integer(0)]
citing_ids <- df$id[indices_with_string]
return(citing_ids)
}
# Create a dummy dataframe:
example_df <- data.frame(
id = c("A01", "B02", "C03", "D04"),
title = c("Work A", "Work B", "Work C", "Work D"),
stringsAsFactors = FALSE
)
# Add the list column for references
# Assume 'CitedWorkX' represents the string for 'work_b' we might search for
example_df$referenced_works <- list(
c("CitedWorkX", "CitedWorkY"),    # A01 cites X and Y
c("CitedWorkZ"),                # B02 cites Z
c("CitedWorkX", "CitedWorkZ"),    # C03 cites X and Z
character(0),                   # D04 cites nothing
NULL                            # Add a row with NULL references
)
#'               within the reference lists in 'df$referenced_works'.
#' @param df The dataframe containing work information. Must include columns
#'           'id' and 'referenced_works'. 'referenced_works' is assumed
#'           to contain lists or vectors of citation strings.
#'
#' @return A vector containing the 'id' values from rows in 'df' where
#'         'work_b' was found in that row's 'referenced_works' list.
#'         Returns an empty vector of the appropriate type (e.g., character(0))
#'         if no citing works are found or if columns are missing.
#'
find_citing_works <- function(work_b, df) {
if (!is.data.frame(df)) {
stop("Error: 'df' must be a data frame.")
}
if (!"referenced_works" %in% names(df)) {
warning("Warning: Dataframe 'df' missing 'referenced_works' column. Returning empty vector.")
# Determine appropriate empty vector type based on 'id' column if it exists
if ("id" %in% names(df)) return(df$id[0]) else return(character(0))
}
if (!"id" %in% names(df)) {
warning("Warning: Dataframe 'df' missing 'id' column. Returning empty vector.")
return(character(0)) # Cannot return IDs if 'id' column is missing
}
if (!is.character(work_b) || length(work_b) != 1) {
stop("Error: 'work_b' must be a single string.")
}
# --- Find Indices ---
# Find indices where work_b exists exactly within the referenced_works list/vector.
# This handles cases where an element in referenced_works might be NULL.
indices_with_string <- which(sapply(df$referenced_works, function(reference_list) {
# Check if reference_list is not NULL before checking for work_b within it
!is.null(reference_list) && work_b %in% reference_list
}))
# --- Retrieve and Return IDs ---
# If no indices found, this correctly returns an empty vector df$id[integer(0)]
citing_ids <- df$id[indices_with_string]
return(citing_ids)
}
# Create a dummy dataframe:
example_df <- data.frame(
id = c("A01", "B02", "C03", "D04"),
title = c("Work A", "Work B", "Work C", "Work D"),
stringsAsFactors = FALSE
)
# Add the list column for references
# Assume 'CitedWorkX' represents the string for 'work_b' we might search for
example_df$referenced_works <- list(
c("CitedWorkX", "CitedWorkY"),    # A01 cites X and Y
c("CitedWorkZ"),                # B02 cites Z
c("CitedWorkX", "CitedWorkZ"),    # C03 cites X and Z
character(0),                   # D04 cites nothing
NULL                            # Add a row with NULL references
)
# Create the dataframe WITH 5 rows from the start
example_df <- data.frame(
id = c("A01", "B02", "C03", "D04", "E05"), # Add the 5th ID
title = c("Work A", "Work B", "Work C", "Work D", "Work E"), # Add the 5th title
stringsAsFactors = FALSE
)
# Now assign the 5-element list - this will work
example_df$referenced_works <- list(
c("CitedWorkX", "CitedWorkY"),    # Row 1 (A01)
c("CitedWorkZ"),                # Row 2 (B02)
c("CitedWorkX", "CitedWorkZ"),    # Row 3 (C03)
character(0),                   # Row 4 (D04)
NULL                            # Row 5 (E05)
)
print(example_df)
# Need to add id/title for the NULL row
example_df$id[5] <- "E05"
example_df$title[5] <- "Work E"
print("--- Example Dataframe ---")
print(example_df)
print("------------------------")
# Test 1: Find works citing "CitedWorkX"
cat("\n--- Finding works citing 'CitedWorkX' ---\n")
ids1 <- find_citing_works(work_b = "CitedWorkX", df = example_df)
print(ids1)
# Test 2: Find works citing "CitedWorkY"
cat("\n--- Finding works citing 'CitedWorkY' ---\n")
ids2 <- find_citing_works(work_b = "CitedWorkY", df = example_df)
print(ids2)
# Test 3: Find works citing "CitedWorkZ"
cat("\n--- Finding works citing 'CitedWorkZ' ---\n")
ids3 <- find_citing_works(work_b = "CitedWorkZ", df = example_df)
print(ids3)
# Test 4: Find works citing a work that isn't cited ("NonExistentWork")
cat("\n--- Finding works citing 'NonExistentWork' ---\n")
ids4 <- find_citing_works(work_b = "NonExistentWork", df = example_df)
print(ids4)
# Test 5: Missing 'referenced_works' column (generates warning)
cat("\n--- Testing with missing 'referenced_works' column ---\n")
temp_df_no_refs <- example_df[, "id", drop = FALSE] # Create df without referenced_works
ids5 <- find_citing_works(work_b = "CitedWorkX", df = temp_df_no_refs)
print(ids5) # Expected: Warning + character(0)
# Test 6: Missing 'id' column (generates warning)
cat("\n--- Testing with missing 'id' column ---\n")
temp_df_no_id <- example_df[, "referenced_works", drop = FALSE] # Create df without id
ids6 <- find_citing_works(work_b = "CitedWorkX", df = temp_df_no_id)
print(ids6) # Expected: Warning + character(0)
